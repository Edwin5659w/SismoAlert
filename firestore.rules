// Modelo: users/{uid} contiene name, email, createdAt, role y preferencias.
// earthquakes/{id} contiene datos sísmicos no personales y solo se consulta.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(userId, data) {
      return !('uid' in data) || data.uid == userId;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(data) {
      return data.keys().hasAll([
        'name', 'email', 'createdAt', 'role', 'alertsEnabled',
        'importantAlerts', 'minMagnitude', 'gpsEnabled', 'alertRadius'
      ]);
    }

    function hasOnlyAllowedFields(data) {
      return data.keys().hasOnly([
        'uid', 'name', 'email', 'createdAt', 'role', 'alertsEnabled',
        'importantAlerts', 'minMagnitude', 'gpsEnabled', 'alertRadius',
        'expoPushToken', 'pushTokenUpdatedAt', 'updatedAt'
      ]);
    }

    function isValidUser(data) {
      return hasRequiredFields(data) &&
        hasOnlyAllowedFields(data) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 254 &&
        data.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$') &&
        data.createdAt is timestamp &&
        data.role == 'user' &&
        data.alertsEnabled is bool &&
        data.importantAlerts is bool &&
        data.minMagnitude in ['3.0+', '4.0+', '5.0+'] &&
        data.gpsEnabled is bool &&
        data.alertRadius in ['20 km', '100 km', '150 km', '300 km'] &&
        (!('expoPushToken' in data) ||
          (data.expoPushToken is string &&
            data.expoPushToken.size() > 0 &&
            data.expoPushToken.size() <= 256)) &&
        (!('pushTokenUpdatedAt' in data) ||
          (data.pushTokenUpdatedAt is timestamp &&
            data.pushTokenUpdatedAt <= request.time)) &&
        (!('updatedAt' in data) ||
          (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        uidUnchanged(userId, request.resource.data) &&
        isValidUser(request.resource.data) &&
        request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId) &&
        uidNotModified() &&
        isValidUser(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'alertsEnabled', 'importantAlerts', 'minMagnitude', 'gpsEnabled',
          'alertRadius', 'expoPushToken', 'pushTokenUpdatedAt', 'updatedAt'
        ]);
    }

    match /earthquakes/{earthquakeId} {
      allow read: if isAuthenticated();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
